{
  "name": "aura-functions",
  "description": "Backend AURA: notifikasi peringatan ke orang tua dan analisis ancaman lapis kedua.",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
