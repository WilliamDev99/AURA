<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Wajib sejak Android 13 agar peringatan bisa muncul di layar. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Menjaga notifikasi darurat tetap sampai saat perangkat sedang hemat daya. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Alarm SOS di HP orang tua diputar layanan latar depan, seperti jam
         alarm, sampai dimatikan (lihat SosAlarmService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Lokasi hanya diambil saat anak menekan tombol darurat, tidak pernah
         dipantau terus-menerus. Karena itu tidak ada izin latar belakang
         (ACCESS_BACKGROUND_LOCATION) di sini. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Jam istirahat di HP anak (lihat ScreenLock.kt): "Akses penggunaan"
         untuk tahu aplikasi apa yang sedang dibuka, dan "Tampil di atas
         aplikasi lain" untuk menutupinya. Keduanya dinyalakan anak sendiri di
         Pengaturan Android. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Jam istirahat: anak mengizinkan AURA tetap berjalan di latar
         belakang. Tanpanya, HP seperti Realme dan OPPO mematikan AURA saat
         daftar aplikasi terbaru dibersihkan, dan kuncinya ikut berhenti. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Tombol SOS tidak menelepon dan tidak mengirim SMS: ia membunyikan
         alarm di HP orang tua lewat internet. Bila gagal terkirim, aplikasi
         Telepon dibuka dengan nomor orang tua terisi, tanpa izin CALL_PHONE. -->

    <application
        android:label="AURA"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Kembali ke AURA setelah login Facebook selesai di browser.
                 Harus sama dengan SupabaseRepository.authRedirect dan
                 terdaftar di Supabase > Authentication > URL Configuration. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="id.aura.aura" android:host="login-callback"/>
            </intent-filter>
            <!-- Tautan login itu dibaca Supabase, bukan router halaman. Tanpa
                 ini, go_router mencoba membukanya sebagai halaman dan
                 menampilkan "Halaman tidak ditemukan". -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false"/>
        </activity>
        <!-- Layar penuh "Jam istirahat" yang menggantikan aplikasi terkunci
             (lihat RestLock.kt). Tidak tampil di daftar aplikasi terbaru. -->
        <activity
            android:name=".RestLockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="id.aura.aura.restlock"
            android:theme="@android:style/Theme.Material.NoActionBar" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Pemindai pesan masuk di ponsel anak. Hanya berjalan setelah anak
             menyalakan "Akses notifikasi" untuk AURA di Pengaturan Android. -->
        <service
            android:name=".AuraNotificationListener"
            android:label="AURA: pemindai pesan berbahaya"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- firebase_messaging 17 mengalamatkan perangkat lewat Firebase
             Installation ID (register/onRegistered). Tanpa tanda ini,
             onRegistered tidak pernah memberi ID dan orang tua tidak pernah
             terdaftar menerima peringatan. -->
        <meta-data
            android:name="firebase_messaging_installation_id_enabled"
            android:value="true" />
        <receiver
            android:name=".SosAlarmStopReceiver"
            android:exported="false" />
        <!-- SOS: pesan FCM bertanda sos langsung membunyikan
             alarm, tanpa menunggu Flutter. Pesan FCM lain tetap ditangani
             firebase_messaging seperti biasa. Hanya Google Play Services
             (pemegang izin SEND) yang boleh memanggilnya. -->
        <receiver
            android:name=".SosPushReceiver"
            android:exported="true"
            android:permission="com.google.android.c2dm.permission.SEND">
            <intent-filter>
                <action android:name="com.google.android.c2dm.intent.RECEIVE" />
            </intent-filter>
        </receiver>
        <!-- Penjaga cadangan jam istirahat (lihat LockWatchdog.kt): menghidupkan
             pengunci lagi bila sistem mematikan AURA. -->
        <service
            android:name=".LockWatchdog"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <service
            android:name=".SosAlarmService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Yang tetap boleh dibuka selama jam istirahat: layar utama,
             telepon, dan jam alarm (lihat ScreenLock.allowedApps). -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.HOME"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_ALARM"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:mimeType="application/vnd.android.package-archive"/>
        </intent>
        <!-- Halaman izin yang dibuka AURA boleh tampil saat jam istirahat. -->
        <intent>
            <action android:name="android.settings.USAGE_ACCESS_SETTINGS"/>
        </intent>
        <intent>
            <action android:name="android.settings.action.MANAGE_OVERLAY_PERMISSION"/>
            <data android:scheme="package"/>
        </intent>
        <intent>
            <action android:name="android.settings.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
            <data android:scheme="package"/>
        </intent>
        <intent>
            <action android:name="android.settings.IGNORE_BATTERY_OPTIMIZATION_SETTINGS"/>
        </intent>
        <intent>
            <action android:name="android.settings.ACTION_NOTIFICATION_LISTENER_SETTINGS"/>
        </intent>
    </queries>
</manifest>
