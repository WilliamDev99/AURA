<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Wajib sejak Android 13 agar peringatan bisa muncul di layar. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Menjaga notifikasi darurat tetap sampai saat perangkat sedang hemat daya. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Lokasi hanya diambil saat anak menekan tombol darurat, tidak pernah
         dipantau terus-menerus. Karena itu tidak ada izin latar belakang
         (ACCESS_BACKGROUND_LOCATION) di sini. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Menelepon orang tua saat anak menekan tombol darurat. Tanpa izin ini,
         aplikasi Telepon dibuka dengan nomor terisi sebagai gantinya. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <application
        android:label="AURA"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Kembali ke AURA setelah login Facebook selesai di browser.
                 Harus sama dengan SupabaseRepository.authRedirect dan
                 terdaftar di Supabase > Authentication > URL Configuration. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="id.aura.aura" android:host="login-callback"/>
            </intent-filter>
            <!-- Tautan login itu dibaca Supabase, bukan router halaman. Tanpa
                 ini, go_router mencoba membukanya sebagai halaman dan
                 menampilkan "Halaman tidak ditemukan". -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false"/>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Pemindai pesan masuk di ponsel anak. Hanya berjalan setelah anak
             menyalakan "Akses notifikasi" untuk AURA di Pengaturan Android. -->
        <service
            android:name=".AuraNotificationListener"
            android:label="AURA: pemindai pesan berbahaya"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- firebase_messaging 17 mengalamatkan perangkat lewat Firebase
             Installation ID (register/onRegistered). Tanpa tanda ini,
             onRegistered tidak pernah memberi ID dan orang tua tidak pernah
             terdaftar menerima peringatan. -->
        <meta-data
            android:name="firebase_messaging_installation_id_enabled"
            android:value="true" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
